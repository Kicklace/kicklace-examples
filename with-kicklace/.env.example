# Kicklace — your keys are under Connections → Your website → Developers.
# Copy this file to .env.local and fill the two keys in. The secret key is for
# your server and never goes in a page; the public key is meant to be in one.
KICKLACE_SECRET_KEY=
NEXT_PUBLIC_KICKLACE_KEY=
KICKLACE_URL=https://www.kicklace.com
NEXT_PUBLIC_KICKLACE_URL=https://www.kicklace.com
