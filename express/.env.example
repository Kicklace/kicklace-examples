# Kicklace — your secret key is under Connections → Your website → For your
# developers, where it is shown once. Copy this file to .env and fill it in.
#
# It is a server key. It must never be in a page, in a repository, or in
# anything a browser downloads. The tag on your website uses the public key
# instead, which goes in the tag's own address.
KICKLACE_SECRET_KEY=
KICKLACE_URL=https://www.kicklace.com

# What port this example listens on.
PORT=3000
